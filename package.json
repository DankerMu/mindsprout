{
  "name": "mindsprout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/native-installed.mjs",
    "setup": "pnpm install --frozen-lockfile",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "build": "next build",
    "native:build": "node scripts/native-package.mjs build",
    "native:verify": "node scripts/native-package.mjs verify",
    "native:test": "node scripts/native-package.mjs test",
    "native:package:test": "node scripts/native-package.test.mjs",
    "native:browser": "node scripts/native-hmr.mjs",
    "native:browser:test": "node --test scripts/native-hmr-support.test.mjs scripts/native-hmr-baseline.test.mjs",
    "native:installed": "node scripts/native-installed.mjs",
    "native:installed:test": "node scripts/native-installed.test.mjs",
    "native:install:test": "node scripts/native-install.test.mjs",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test:unit && pnpm test:integration && pnpm anti-drift && pnpm docs:check && pnpm decisions:check && pnpm build",
    "check:fast": "bash scripts/check-fast.sh",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:licenses": "node --test scripts/check-licenses.test.mjs",
    "dead-code": "knip --reporter compact",
    "duplicate-code": "jscpd --config jscpd.json src",
    "anti-drift": "pnpm test:licenses && pnpm licenses:check && pnpm dead-code && pnpm duplicate-code",
    "docs:check": "node scripts/check-docs.mjs",
    "decisions:check": "node scripts/check-decisions.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "change-scope": "bash scripts/change-scope.sh",
    "dev:bg": "bash scripts/dev-bg.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "dev:status": "bash scripts/dev-status.sh",
    "logs": "tail -n 100 -f .run/dev.log",
    "smoke": "hurl --test smoke/*.hurl --variable base_url=http://localhost:3000",
    "e2e": "playwright test",
    "verify-ui": "playwright test --grep",
    "test:guardrails": "bash scripts/test-guardrails.sh",
    "mutation": "stryker run",
    "changeset": "changeset"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@vercel/otel": "^2.2.1",
    "@xyflow/react": "^12.12.1",
    "d3-hierarchy": "^3.1.2",
    "idb": "^8.0.4",
    "nanoid": "^5.1.16",
    "next": "^16.4.5",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@next/swc-darwin-arm64@16.4.5": "https://github.com/DankerMu/mindsprout/releases/download/native-next-16.4.5-006609c1cfbb/darwin-arm64-39884c6086b48feb0a93e1ce7a5d2b29c4aa5fd89aecc815087cc75c6d1b6ea8.tgz",
      "@next/swc-linux-x64-gnu@16.4.5": "https://github.com/DankerMu/mindsprout/releases/download/native-next-16.4.5-006609c1cfbb/linux-x64-gnu-503069bdd708d0b199c2e5741953954f925be9d4f700555cbbd3062ab58d862e.tgz"
    }
  }
}
