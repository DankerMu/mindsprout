# 以下全部只在服务端使用，不要提交真实值。Agents: 只看键名，永远不读 .env 的值。

# 运行
NODE_ENV=development
LOG_LEVEL=info
# Local Postgres; integration and e2e derive app_test and app_e2e from these URLs.
# Test lifecycle URLs discard database query overrides; other connection options are preserved.
DATABASE_URL=postgres://mindsprout_app:app@localhost:5432/app_dev
MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/app_dev
# OpenTelemetry 导出端点（可选）
OTEL_EXPORTER_OTLP_ENDPOINT=

# AI 生成（可选）：AI_PROVIDER 留空 = 不启用 AI，生成接口返回 503 ai-unavailable。
# 空值一律视为未设置；选定提供方后缺少必填项会在加载时报错。
# 平台默认（Anthropic 协议）：
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=<你的 key>
#   ANTHROPIC_BASE_URL=https://www.dmxapi.cn
#   AI_MODEL=deepseek-v4.1-flash-1017
# 备选（OpenAI 兼容协议）：
#   AI_PROVIDER=openai-compatible
#   OPENAI_API_KEY=<你的 key>
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   （OPENAI_BASE_URL 可换成任一 OpenAI 兼容端点，须带 http(s)://）
#   AI_MODEL=deepseek-v4.1-flash-1017
# AI_PROVIDER=mock 仅用于本地验证，NODE_ENV=production 时拒绝加载。
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 用户自定义提供方 Key 的加密密钥
PROVIDER_KEY_ENCRYPTION_SECRET=
