# 以下全部只在服务端使用，不要提交真实值。Agents: 只看键名，永远不读 .env 的值。

# 运行
NODE_ENV=development
LOG_LEVEL=info
# Local Postgres; integration and e2e derive app_test and app_e2e from these URLs.
# Test lifecycle URLs discard database query overrides; other connection options are preserved.
DATABASE_URL=postgres://app:app@localhost:5432/app_dev
MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/app_dev
# OpenTelemetry 导出端点（可选）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 内置提供方（至少配一个）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 本地开源模型，Ollama 默认地址
OLLAMA_BASE_URL=http://localhost:11434/v1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 用户自定义提供方 Key 的加密密钥
PROVIDER_KEY_ENCRYPTION_SECRET=
