+use anyhow::Result;
+use turbo_tasks::{OperationVc, Vc};
+
+#[turbo_tasks::function(operation, self_operation = operation)]
+fn sync_identity(value: u32) -> Vc<u32> {
+    let _: OperationVc<u32> = operation;
+    Vc::cell(value)
+}
+
+#[turbo_tasks::function(operation, root, self_operation = operation)]
+async fn async_identity(value: u32) -> Result<Vc<u32>> {
+    let _: OperationVc<u32> = operation;
+    Ok(Vc::cell(value))
+}
+
+#[allow(dead_code)]
+fn unchanged_call_signature() {
+    let _: OperationVc<u32> = sync_identity(1);
+    let _: OperationVc<u32> = async_identity(2);
+}
+
+fn main() {}
