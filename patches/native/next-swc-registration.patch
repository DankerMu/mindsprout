+    #[turbo_tasks::function(operation, root)]
+    async fn producer_a(root: FileSystemPath) -> Result<Vc<ExpandedOutputAssets>> {
+        Ok(Vc::cell(vec![
+            fixture_asset(&root, "main.js", "main from A").await?,
+            fixture_asset(&root, "home.js", "home from A").await?,
+        ]))
+    }
+
+    #[turbo_tasks::function(operation, root)]
+    async fn producer_b(root: FileSystemPath) -> Result<Vc<ExpandedOutputAssets>> {
+        // Different content at the shared path makes first-producer selection observable.
+        Ok(Vc::cell(vec![
+            fixture_asset(&root, "main.js", "main from B").await?,
+            fixture_asset(&root, "editor.js", "editor from B").await?,
+        ]))
+    }
+
+    type AssetSnapshot = Option<(String, String, bool)>;
+
+    #[turbo_tasks::function(operation, root)]
+    fn lookup_asset_operation(
+        map: ResolvedVc<VersionedContentMap>,
+        path: FileSystemPath,
+    ) -> Vc<OptionOutputAsset> {
+        map.get_asset(path)
+    }
+
+    async fn lookup_asset(
+        map: ResolvedVc<VersionedContentMap>,
+        path: FileSystemPath,
+        expected_asset: ResolvedVc<Box<dyn OutputAsset>>,
+    ) -> Result<AssetSnapshot> {
+        let Some(asset) = *lookup_asset_operation(map, path)
+            .read_strongly_consistent()
+            .await?
+        else {
+            return Ok(None);
+        };
+        let path = asset.path().await?.path.to_string();
+        let content = asset.content().file_content().await?;
+        let file = content.as_content().context("expected a file asset")?;
+        Ok(Some((
+            path,
+            file.content().to_str()?.to_string(),
+            asset == expected_asset,
+        )))
+    }
+
+    fn open_backend(path: &Path) -> Arc<TurboTasks<TurboTasksBackend>> {
+        TurboTasks::new(TurboTasksBackend::new(
+            BackendOptions {
+                num_workers: Some(2),
+                small_preallocation: true,
+                storage_mode: Some(StorageMode::ReadWriteOnShutdown),
+                eviction_mode: EvictionMode::Full,
+                gc: Some(true),
+                ..Default::default()
+            },
+            turbo_backing_storage(
+                path,
+                &GitVersionInfo {
+                    describe: "versioned-content-map-test",
+                    dirty: false,
+                },
+                BackingStorageOptions {
+                    is_short_session: true,
+                    skip_compaction: true,
+                    ..Default::default()
+                },
+            )
+            .unwrap()
+            .0,
