+    #[turbo_tasks::value(transparent)]
+    struct SessionSnapshot((AssetSnapshot, AssetSnapshot, AssetSnapshot, bool));
+
+    #[turbo_tasks::value(transparent)]
+    struct RestoredSessionSnapshot(
+        (
+            AssetSnapshot,
+            AssetSnapshot,
+            AssetSnapshot,
+            bool,
+            OperationVc<ExpandedOutputAssets>,
+        ),
+    );
+
+    #[turbo_tasks::function(operation, root)]
+    async fn session_snapshot(
+        output_path: RcStr,
+        restored: bool,
+    ) -> Result<Vc<RestoredSessionSnapshot>> {
+        let map = fixture_map().to_resolved().await?;
+        let root = fixture_root().owned().await?;
+        let node_root = fixture_node_root(output_path).owned().await?;
+        let client_output = node_root.join("client")?;
+        let a = producer_a(root.clone());
+        let b = producer_b(root.clone());
+
+        if !restored {
+            map.insert_output_assets(a, node_root.clone(), root.clone(), client_output.clone())
+                .await?;
+        }
+        // Demand the same persisted compute root, not A's registration caller.
+        compute_entry_operation(
+            map,
+            a,
+            node_root.clone(),
+            root.clone(),
+            client_output.clone(),
+        )
+        .read_strongly_consistent()
+        .await?;
+
+        map.insert_output_assets(b, node_root.clone(), root.clone(), client_output.clone())
+            .await?;
+        compute_entry_operation(map, b, node_root, root.clone(), client_output)
+            .read_strongly_consistent()
+            .await?;
+
+        let a_assets = a.read_strongly_consistent().await?;
+        let b_assets = b.read_strongly_consistent().await?;
+        let main = lookup_asset(map, root.join("main.js")?, a_assets[0]).await?;
+        let home = lookup_asset(map, root.join("home.js")?, a_assets[1]).await?;
+        let editor = lookup_asset(map, root.join("editor.js")?, b_assets[1]).await?;
+        let missing = lookup_asset_operation(map, root.join("missing.js")?)
+            .read_strongly_consistent()
+            .await?
+            .is_none();
+        Ok(Vc::cell((main, home, editor, missing, a)))
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn restored_producer_assets_remain_available_without_reinsertion() {
+        let cache = tempfile::tempdir().unwrap();
+        let output = tempfile::tempdir().unwrap();
+        let mut seeded_operation = None;
+
+        for restored in [false, true] {
+            let tt = open_backend(cache.path());
+            if let Some((task, session_root)) = seeded_operation {
+                // A has persistent parents; the session operation is the persisted GC root.
+                assert!(
+                    tt.backend()
+                        .persisted_gc_roots_for_testing()
+                        .iter()
+                        .any(|(root, _)| *root == session_root),
+                    "the seed session root must persist before any fixture task is requested"
+                );
+                tt.backend()
+                    .assert_task_exists_for_testing(session_root, &tt);
+                tt.backend().assert_task_exists_for_testing(task, &tt);
+            }
+            let output_path: RcStr = output.path().to_str().unwrap().into();
+            let result = tt
+                .run_once(async move {
+                    let session = session_snapshot(output_path, restored);
+                    let snapshot = session.read_strongly_consistent().await?;
+                    let (main, home, editor, missing, a) = (*snapshot).clone();
+                    anyhow::Ok((
+                        (main, home, editor, missing),
+                        GcRoot::pin(turbo_tasks(), a),
+                        GcRoot::pin(turbo_tasks(), session),
+                    ))
+                })
+                .await;
+            tt.stop_and_wait().await;
+            let ((main, home, editor, missing), pin, session_pin) = result.unwrap();
+            let task = pin.task_id();
+            let session_root = session_pin.task_id();
+            drop(session_pin);
+            drop(pin);
+            drop(tt);
+            if let Some((seeded, _)) = seeded_operation {
+                assert_eq!(
+                    task, seeded,
+                    "producer A must retain its persisted task identity"
+                );
+            } else {
+                seeded_operation = Some((task, session_root));
+            }
+            assert!(missing, "an unpublished path must remain absent");
+            assert_eq!(
+                editor,
+                Some(("editor.js".into(), "editor from B".into(), true)),
+                "producer B must retain its asset identity and content (restored={restored})"
+            );
+            assert_eq!(
+                main,
+                Some(("main.js".into(), "main from A".into(), true)),
+                "shared main must retain the first producer's asset (restored={restored})"
+            );
+            assert_eq!(
+                home,
+                Some(("home.js".into(), "home from A".into(), true)),
+                "sole-producer home must remain available (restored={restored})"
+            );
+        }
+    }
+
+    #[turbo_tasks::value(transparent)]
+    struct HomeIncluded(State<bool>);
+
+    #[turbo_tasks::function(operation, root)]
+    fn home_included() -> Vc<HomeIncluded> {
+        HomeIncluded(State::new(true)).cell()
+    }
+
+    #[turbo_tasks::function(operation, root)]
+    async fn removable_producer(
+        root: FileSystemPath,
+        included: ResolvedVc<HomeIncluded>,
+    ) -> Result<Vc<ExpandedOutputAssets>> {
+        let include_home = *included.await?.get();
+        let mut assets = vec![fixture_asset(&root, "main.js", "main from A").await?];
+        if include_home {
+            assets.push(fixture_asset(&root, "home.js", "home from A").await?);
+        }
+        Ok(Vc::cell(assets))
+    }
+
+    #[turbo_tasks::function(operation, root)]
+    async fn removal_snapshot(
+        output_path: RcStr,
+        included: ResolvedVc<HomeIncluded>,
+    ) -> Result<Vc<SessionSnapshot>> {
+        let map = fixture_map().to_resolved().await?;
+        let root = fixture_root().owned().await?;
+        let node_root = fixture_node_root(output_path).owned().await?;
+        let client_output = node_root.join("client")?;
+        let a = removable_producer(root.clone(), included);
+        let b = producer_b(root.clone());
+        map.insert_output_assets(a, node_root.clone(), root.clone(), client_output.clone())
+            .await?;
+        compute_entry_operation(
+            map,
+            a,
+            node_root.clone(),
+            root.clone(),
+            client_output.clone(),
+        )
+        .read_strongly_consistent()
+        .await?;
+        map.insert_output_assets(b, node_root.clone(), root.clone(), client_output.clone())
+            .await?;
+        compute_entry_operation(map, b, node_root, root.clone(), client_output)
+            .read_strongly_consistent()
+            .await?;
+        let a_assets = a.read_strongly_consistent().await?;
+        let b_assets = b.read_strongly_consistent().await?;
+        // After removal no identity can match: lookup must return None.
+        let home_asset = a_assets.get(1).copied().unwrap_or(a_assets[0]);
+        let main = lookup_asset(map, root.join("main.js")?, a_assets[0]).await?;
+        let home = lookup_asset(map, root.join("home.js")?, home_asset).await?;
+        let editor = lookup_asset(map, root.join("editor.js")?, b_assets[1]).await?;
+        let missing = lookup_asset_operation(map, root.join("missing.js")?)
+            .read_strongly_consistent()
+            .await?
+            .is_none();
+        Ok(Vc::cell((main, home, editor, missing)))
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn removed_sole_asset_disappears_without_changing_shared_precedence() {
+        let cache = tempfile::tempdir().unwrap();
+        let output = tempfile::tempdir().unwrap();
+        let tt = open_backend(cache.path());
+        let output_path: RcStr = output.path().to_str().unwrap().into();
+        let result = tt
+            .run_once(async move {
+                let included_op = home_included();
+                let included = included_op.resolve().strongly_consistent().await?;
+                let state = included_op.read_strongly_consistent().await?;
+                let snapshot = removal_snapshot(output_path, included);
+                let before = snapshot.read_strongly_consistent().await?;
+                assert_eq!(
+                    *before,
+                    (
+                        Some(("main.js".into(), "main from A".into(), true)),
+                        Some(("home.js".into(), "home from A".into(), true)),
+                        Some(("editor.js".into(), "editor from B".into(), true)),
+                        true,
+                    )
+                );
+                state.set(false);
+                let after = snapshot.read_strongly_consistent().await?;
+                assert_eq!(
+                    *after,
+                    (
+                        Some(("main.js".into(), "main from A".into(), true)),
+                        None,
+                        Some(("editor.js".into(), "editor from B".into(), true)),
+                        true,
+                    )
+                );
+                anyhow::Ok(())
+            })
+            .await;
+        tt.stop_and_wait().await;
+        result.unwrap();
+    }
+}
