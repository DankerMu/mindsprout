openapi: 3.1.0
info:
  title: "MindSprout API"
  version: "0.1.0"
paths:
  /api/healthz:
    get:
      summary: Liveness and dependency probe
      responses:
        "200":
          description: Process is up and dependencies are reachable or not configured
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Health"
        "503":
          description: A dependency probe failed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Health"
  /api/auth/session:
    get:
      summary: Read the current session
      responses:
        "200":
          description: The session identifies a user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "401":
          description: The session is missing or invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/register:
    post:
      summary: Register an account and create a session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Credentials"
      responses:
        "201":
          description: The account and session were created
          headers:
            Set-Cookie:
              $ref: "#/components/headers/SessionCookie"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "400":
          description: Malformed JSON or invalid credentials input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-input
        "409":
          description: The exact username is already registered
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: username-taken
        "415":
          description: Content-Type is not application/json
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/login:
    post:
      summary: Sign in and create a session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Credentials"
      responses:
        "200":
          description: The credentials identify a user and a session was created
          headers:
            Set-Cookie:
              $ref: "#/components/headers/SessionCookie"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "400":
          description: Malformed JSON or invalid credentials input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-input
        "401":
          description: The credentials are invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-credentials
        "415":
          description: Content-Type is not application/json
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/logout:
    post:
      summary: End the current session and clear its cookie
      requestBody:
        description: Canonical empty object; no payload fields are consumed
        required: true
        content:
          application/json:
            schema:
              type: object
            example: {}
      responses:
        "204":
          description: The session ended or was absent; the cookie is cleared
          headers:
            Set-Cookie:
              description: Empty mindsprout_session cookie; Max-Age=0, HttpOnly, SameSite=Lax, Path=/, Secure in production
              schema:
                type: string
        "415":
          description: Content-Type is not application/json; session and cookie are unchanged
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure; the cookie is not cleared
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
components:
  headers:
    SessionCookie:
      description: mindsprout_session cookie; HttpOnly, SameSite=Lax, Path=/, Max-Age=2592000, Secure in production
      schema:
        type: string
  schemas:
    Credentials:
      type: object
      required: [username, password]
      properties:
        username:
          type: string
          description: Exact string, 1–64 UTF-16 code units; no trimming or normalization
        password:
          type: string
          description: Exact string, 1–256 UTF-16 code units
    Health:
      type: object
      required: [status, checks]
      properties:
        status:
          type: string
          enum: [ok, degraded]
        checks:
          type: object
          required: [db]
          properties:
            db:
              type: string
              enum: [ok, fail, not-configured]
    PublicSession:
      type: object
      additionalProperties: false
      required: [username, isAdmin]
      properties:
        username:
          type: string
        isAdmin:
          type: boolean
    Error:
      type: object
      additionalProperties: false
      required: [error]
      properties:
        error:
          type: string
