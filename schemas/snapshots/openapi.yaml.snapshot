openapi: 3.1.0
info:
  title: "MindSprout API"
  version: "0.1.0"
paths:
  /api/healthz:
    get:
      summary: Liveness and dependency probe
      responses:
        "200":
          description: Process is up and dependencies are reachable or not configured
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Health"
        "503":
          description: A dependency probe failed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Health"
  /native-auth/{mode}:
    post:
      summary: Return a native credential submission to a readable retry form
      description: Ignores the body and does not authenticate, create an account, or set cookies.
      parameters:
        - name: mode
          in: path
          required: true
          schema: { type: string, enum: [login, register] }
        - name: next
          in: query
          description: Optional same-site return path and query; unsafe values become `/`.
          schema: { type: string }
      requestBody:
        content:
          application/x-www-form-urlencoded:
            schema: { type: object }
      responses:
        "303":
          description: Return to the corresponding form with `native=1` and optional sanitized `next`
          headers:
            Location:
              description: Relative same-origin form URL
              schema: { type: string, example: "/login?native=1" }
        "404":
          description: Unsupported mode
  /api/auth/session:
    get:
      summary: Read the current session
      responses:
        "200":
          description: The session identifies a user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "401":
          description: The session is missing or invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/register:
    post:
      summary: Register an account and create a session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Credentials"
      responses:
        "201":
          description: The account and session were created
          headers:
            Set-Cookie:
              $ref: "#/components/headers/SessionCookie"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "400":
          description: Malformed JSON or invalid credentials input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-input
        "409":
          description: The exact username is already registered
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: username-taken
        "415":
          description: Content-Type is not application/json
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/login:
    post:
      summary: Sign in and create a session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Credentials"
      responses:
        "200":
          description: The credentials identify a user and a session was created
          headers:
            Set-Cookie:
              $ref: "#/components/headers/SessionCookie"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicSession"
        "400":
          description: Malformed JSON or invalid credentials input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-input
        "401":
          description: The credentials are invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-credentials
        "415":
          description: Content-Type is not application/json
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/auth/logout:
    post:
      summary: End the current session and clear both cookies
      requestBody:
        description: Canonical empty object; no payload fields are consumed
        required: true
        content:
          application/json:
            schema:
              type: object
            example: {}
      responses:
        "204":
          description: The session ended or was absent; both cookies are cleared
          headers:
            Set-Cookie:
              description: Two Set-Cookie fields clear mindsprout_session and mindsprout_session_binding; Max-Age=0, SameSite=Lax, Path=/, Secure in production; only mindsprout_session is HttpOnly
              schema:
                type: string
        "415":
          description: Content-Type is not application/json; session and both cookies are unchanged
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure; neither cookie is cleared
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/maps:
    parameters:
      - $ref: "#/components/parameters/SessionBinding"
    get:
      summary: List the current user's maps
      responses:
        "200":
          description: Summaries ordered by updatedAt descending, then id ascending in UTF-16 code-unit order; readable newer-version summaries are included
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/MapSummary"
        "401":
          description: The session is missing or invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/maps/{id}:
    parameters:
      - $ref: "#/components/parameters/SessionBinding"
    get:
      summary: Read one of the current user's maps
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: The stored map in a version-one envelope
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MapEnvelope"
        "401":
          description: The session is missing or invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "404":
          description: The map is absent or held only by another user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: not-found
        "409":
          description: The stored map has a newer schema version
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UnsupportedSchemaVersion"
              example:
                error: unsupported-schema-version
                found: 2
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
    put:
      summary: Create or replace one of the current user's maps
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        description: Version-one envelope whose map id equals the path id; at most 1048576 bytes, checked by Content-Length and actual bytes read
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/MapEnvelope"
      responses:
        "204":
          description: The caller's map was created or replaced; no response body
        "400":
          description: Malformed JSON, invalid map, schemaVersion other than 1 or embedded id differing from the path; nothing written
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: invalid-map
        "401":
          description: The session is missing or invalid; checked before media type or body
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "413":
          description: Declared or actual body size exceeds 1048576 bytes; nothing written
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: too-large
        "415":
          description: Content-Type is not application/json; nothing written
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
    delete:
      summary: Delete one of the current user's maps
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        description: Canonical empty object; no payload fields are consumed
        required: true
        content:
          application/json:
            schema:
              type: object
            example: {}
      responses:
        "204":
          description: The caller's map was deleted or was absent, including an id held only by another user; no response body
        "401":
          description: The session is missing or invalid; checked before media type
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "415":
          description: Content-Type is not application/json; nothing deleted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/admin/users:
    get:
      summary: List accounts as the administrator
      responses:
        "200":
          description: Public accounts in creation-time ascending order; no credentials
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/PublicUser"
        "401":
          description: The session is missing or invalid
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "403":
          description: The signed-in user is not the administrator
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: forbidden
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
  /api/admin/users/{id}/password-reset:
    post:
      summary: Reset an account password as the administrator
      description: Ends all target sessions atomically; no response sets or clears a cookie, including self-reset
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
      requestBody:
        description: Canonical empty object; no payload fields are consumed
        required: true
        content:
          application/json:
            schema:
              type: object
            example: {}
      responses:
        "200":
          description: The temporary password appears only in this response body
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PasswordReset"
        "401":
          description: The session is missing or invalid; checked before media type and target
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unauthenticated
        "403":
          description: The signed-in user is not the administrator; checked before target validation
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: forbidden
        "404":
          description: The target account is absent or the id is not a canonical hyphenated UUID
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: not-found
        "415":
          description: Content-Type is not application/json; checked before administrator authorization or target access
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: unsupported-media-type
        "500":
          description: An unexpected internal failure
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: internal
components:
  parameters:
    SessionBinding:
      name: x-mindsprout-session-binding
      in: header
      required: false
      description: Optional opaque base64url UTF-8 exact-username binding captured by the first-party map adapter. A present value differing from the authenticated account returns 401 unauthenticated before map access. Omission preserves direct-API behavior. This is not an authentication credential.
      schema:
        type: string
  headers:
    SessionCookie:
      description: Two Set-Cookie fields set mindsprout_session (HttpOnly) and mindsprout_session_binding (non-HttpOnly base64url UTF-8 exact username); both SameSite=Lax, Path=/, Max-Age=2592000, Secure in production
      schema:
        type: string
  schemas:
    Credentials:
      type: object
      required: [username, password]
      properties:
        username:
          type: string
          description: Exact string, 1–64 UTF-16 code units; no trimming or normalization
        password:
          type: string
          description: Exact string, 1–256 UTF-16 code units
    Health:
      type: object
      required: [status, checks]
      properties:
        status:
          type: string
          enum: [ok, degraded]
        checks:
          type: object
          required: [db]
          properties:
            db:
              type: string
              enum: [ok, fail, not-configured]
    PublicSession:
      type: object
      additionalProperties: false
      required: [username, isAdmin]
      properties:
        username:
          type: string
        isAdmin:
          type: boolean
    PublicUser:
      type: object
      additionalProperties: false
      required: [id, username, isAdmin, createdAt]
      properties:
        id:
          type: string
          format: uuid
        username:
          type: string
        isAdmin:
          type: boolean
        createdAt:
          type: string
          format: date-time
    PasswordReset:
      type: object
      additionalProperties: false
      required: [temporaryPassword]
      properties:
        temporaryPassword:
          type: string
          minLength: 16
          maxLength: 16
          pattern: "^[A-Za-z0-9_-]{16}$"
    Error:
      type: object
      additionalProperties: false
      required: [error]
      properties:
        error:
          type: string
    MapSummary:
      type: object
      additionalProperties: false
      required: [id, title, updatedAt]
      properties:
        id:
          type: string
        title:
          type: string
        updatedAt:
          type: string
    Position:
      type: object
      additionalProperties: false
      required: [x, y]
      properties:
        x:
          type: number
        y:
          type: number
    ColorToken:
      type: string
      enum: [red, orange, yellow, green, blue, purple]
    MindNode:
      type: object
      additionalProperties: false
      required: [id, text, children]
      properties:
        id:
          type: string
        text:
          type: string
        note:
          type: string
        color:
          $ref: "#/components/schemas/ColorToken"
        collapsed:
          type: boolean
        position:
          $ref: "#/components/schemas/Position"
        children:
          type: array
          items:
            allOf:
              - $ref: "#/components/schemas/MindNode"
              - not:
                  required: [position]
    MindMap:
      type: object
      additionalProperties: false
      description: A forest with unique node ids across all depths. The primary root has no position; each floating root has a finite position; non-root nodes have no position.
      required: [id, title, roots, createdAt, updatedAt]
      properties:
        id:
          type: string
        title:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        roots:
          type: array
          minItems: 1
          prefixItems:
            - allOf:
                - $ref: "#/components/schemas/MindNode"
                - not:
                    required: [position]
          items:
            allOf:
              - $ref: "#/components/schemas/MindNode"
              - required: [position]
    MapEnvelope:
      type: object
      additionalProperties: false
      required: [schemaVersion, map]
      properties:
        schemaVersion:
          type: integer
          const: 1
        map:
          $ref: "#/components/schemas/MindMap"
    UnsupportedSchemaVersion:
      type: object
      additionalProperties: false
      required: [error, found]
      properties:
        error:
          type: string
          const: unsupported-schema-version
        found:
          type: integer
          minimum: 2
